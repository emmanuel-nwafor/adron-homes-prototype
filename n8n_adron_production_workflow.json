{
  "name": "Adron Homes Autonomous 5-Tool AI Real Estate Sales Workflow (Production Ready)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "adron-lead-ai",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node_webhook_enquiry",
      "name": "1. Webhook - Lead Enquiry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "adron-subscribe",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node_webhook_subscribe",
      "name": "2. Webhook - Subscription",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 500]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "adron-ai-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node_webhook_chat",
      "name": "3. Webhook - AI Chatbot Query",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 900]
    },
    {
      "parameters": {
        "sendTo": "sales@adronhomesproperties.com",
        "subject": "=🚨 NEW CUSTOMER ENQUIRY: {{ $json.body.fullName }} - {{ $json.body.propertyTitle || 'General' }}",
        "emailType": "html",
        "message": "=<h2>🚨 New Adron Homes Customer Lead Enquiry</h2><p><strong>Full Name:</strong> {{ $json.body.fullName }}</p><p><strong>Phone:</strong> {{ $json.body.phone }}</p><p><strong>Email:</strong> {{ $json.body.email || 'N/A' }}</p><p><strong>Estate Title:</strong> {{ $json.body.propertyTitle || 'General Enquiry' }}</p><p><strong>Preferred Tour Inspection Date:</strong> {{ $json.body.preferredInspectionDate || 'Not specified' }}</p><p><strong>Question/Request:</strong> {{ $json.body.message || 'No additional question' }}</p><hr/><p><em>Recorded automatically via Adron Web Prototype API.</em></p>",
        "options": {}
      },
      "id": "node_gmail_enquiry",
      "name": "Gmail - Alert Sales Team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [400, 150]
    },
    {
      "parameters": {
        "channel": "#leads-adron-sales",
        "text": "=🚨 *NEW CUSTOMER ENQUIRY RECEIVED*\n*Name:* {{ $json.body.fullName }}\n*Phone:* {{ $json.body.phone }}\n*Email:* {{ $json.body.email || 'N/A' }}\n*Estate:* {{ $json.body.propertyTitle || 'General' }}\n*Inspection Tour Date:* {{ $json.body.preferredInspectionDate || 'Not specified' }}\n*Question:* {{ $json.body.message || 'None' }}",
        "otherOptions": {}
      },
      "id": "node_slack_enquiry",
      "name": "Slack - Notify #leads-adron-sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [400, 280]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "1_Adron_Enquiries_Master_Sheet_ID",
        "range": "Enquiries!A:H",
        "options": {},
        "dataMode": "autoMapInputData"
      },
      "id": "node_gsheets_enquiry",
      "name": "Google Sheets - Log Enquiries (Master Sheet 1)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [400, 410]
    },
    {
      "parameters": {
        "sendTo": "subscriptions@adronhomesproperties.com",
        "subject": "=🎉 NEW ESTATE SUBSCRIPTION: {{ $json.body.title || '' }} {{ $json.body.fullName }} - {{ $json.body.propertyTitle }}",
        "emailType": "html",
        "message": "=<h2>🎉 New Estate Subscription Record</h2><p><strong>Subscriber:</strong> {{ $json.body.title || '' }} {{ $json.body.fullName }}</p><p><strong>Phone:</strong> {{ $json.body.phone }}</p><p><strong>Email:</strong> {{ $json.body.email }}</p><p><strong>Estate Subscribed:</strong> {{ $json.body.propertyTitle }}</p><p><strong>Referred by Marketer:</strong> {{ $json.body.referredByMarketer ? 'YES' : 'NO' }}</p><hr/><p><em>Transmitted to Adron Subscriptions Management.</em></p>",
        "options": {}
      },
      "id": "node_gmail_subscribe",
      "name": "Gmail - Alert Subscriptions Team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [400, 480]
    },
    {
      "parameters": {
        "channel": "#subscriptions",
        "text": "=🎉 *NEW ESTATE SUBSCRIPTION RECORDED*\n*Subscriber:* {{ $json.body.title || '' }} {{ $json.body.fullName }}\n*Phone:* {{ $json.body.phone }}\n*Email:* {{ $json.body.email }}\n*Estate:* {{ $json.body.propertyTitle }}\n*Referred by Marketer:* {{ $json.body.referredByMarketer ? 'YES' : 'NO' }}",
        "otherOptions": {}
      },
      "id": "node_slack_subscribe",
      "name": "Slack - Notify #subscriptions",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [400, 610]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "2_Adron_Subscriptions_Master_Sheet_ID",
        "range": "Subscriptions!A:H",
        "options": {},
        "dataMode": "autoMapInputData"
      },
      "id": "node_gsheets_subscribe",
      "name": "Google Sheets - Log Subscriptions (SEPARATE Sheet 2)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [400, 740]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-pro",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "node_gemini_model",
      "name": "Google Gemini 1.5 Pro Model",
      "type": "n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [300, 1250]
    },
    {
      "parameters": {
        "sessionId": "={{ $json.body.sessionId || 'session_adron' }}",
        "sessionTTL": 3600
      },
      "id": "node_mongodb_memory",
      "name": "MongoDB Chat Memory",
      "type": "n8n-nodes-langchain.memoryMongoDbChat",
      "typeVersion": 1,
      "position": [450, 1250]
    },
    {
      "parameters": {
        "name": "search_properties_api",
        "description": "TOOL 1: Search Adron Homes properties catalog by maximum budget (maxPrice), location, state, or property type. Returns array of matching properties with prices, C of O titles, and image thumbnail URLs.",
        "method": "GET",
        "url": "https://adron-homes-prototype.vercel.app/api/properties",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "maxPrice",
              "value": "={{ $fromAI('maxPrice', 'Maximum budget in Naira, e.g. 20000000') }}"
            },
            {
              "name": "state",
              "value": "={{ $fromAI('state', 'State name if specified, e.g. Lagos, Ogun, Abuja') }}"
            }
          ]
        }
      },
      "id": "node_tool_search",
      "name": "Tool 1 — Search Properties API",
      "type": "n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [600, 1150]
    },
    {
      "parameters": {
        "name": "get_property_details_api",
        "description": "TOOL 2: Get detailed plot breakdown (300sqm half plot / 500sqm full plot), legal title verification, and payment plans for a specific property by ID or slug.",
        "method": "GET",
        "url": "=https://adron-homes-prototype.vercel.app/api/properties/{{ $fromAI('propertyId', 'Property ID or slug, e.g. eko-city-shimawa') }}"
      },
      "id": "node_tool_details",
      "name": "Tool 2 — Get Property Details API",
      "type": "n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [600, 1250]
    },
    {
      "parameters": {
        "name": "faq_knowledgebase_api",
        "description": "TOOL 3: Fetch official Adron Homes FAQ & Knowledgebase answers regarding 36-month flexible installment plans, legal C of O title verification, and site inspection pickup locations.",
        "method": "GET",
        "url": "https://adron-homes-prototype.vercel.app/api/faq"
      },
      "id": "node_tool_faq",
      "name": "Tool 3 — FAQ Knowledgebase API",
      "type": "n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [600, 1350]
    },
    {
      "parameters": {
        "name": "create_lead_api",
        "description": "TOOL 4: Create a sales callback lead when a user says 'I am interested, have someone contact me' or requests a sales representative call.",
        "method": "POST",
        "url": "https://adron-homes-prototype.vercel.app/api/enquiry",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "fullName",
              "value": "={{ $fromAI('fullName', 'User full name') }}"
            },
            {
              "name": "phone",
              "value": "={{ $fromAI('phone', 'User phone number') }}"
            },
            {
              "name": "message",
              "value": "Sales Representative Callback Request"
            }
          ]
        }
      },
      "id": "node_tool_lead",
      "name": "Tool 4 — Create Lead API",
      "type": "n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [600, 1450]
    },
    {
      "parameters": {
        "name": "schedule_inspection_api",
        "description": "TOOL 5: Schedule or book a free daily site tour inspection when a user says 'I would like to inspect the property tomorrow' or selects a tour date.",
        "method": "POST",
        "url": "https://adron-homes-prototype.vercel.app/api/enquiry",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "fullName",
              "value": "={{ $fromAI('fullName', 'User full name') }}"
            },
            {
              "name": "phone",
              "value": "={{ $fromAI('phone', 'User phone number') }}"
            },
            {
              "name": "preferredInspectionDate",
              "value": "={{ $fromAI('preferredInspectionDate', 'Requested tour date, e.g. tomorrow or YYYY-MM-DD') }}"
            }
          ]
        }
      },
      "id": "node_tool_inspection",
      "name": "Tool 5 — Schedule Inspection API",
      "type": "n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [600, 1550]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are AdBot, executive real estate consultant for Adron Homes & Properties Nigeria.\n\nYou possess 5 specialized HTTP tools:\n1. 'search_properties_api': Use when user asks for properties matching a budget or location.\n2. 'get_property_details_api': Use when user asks for plot details (300sqm half plot, 500sqm full plot).\n3. 'faq_knowledgebase_api': Use when user asks about 36-month payment terms, C of O titles, or site tours.\n4. 'create_lead_api': Use when user says 'have someone contact me'.\n5. 'schedule_inspection_api': Use when user says 'inspect property tomorrow'.\n\nALWAYS format property listings cleanly with prices, C of O title, and markdown images ![Image](url)."
        }
      },
      "id": "node_ai_agent",
      "name": "Adron 5-Tool AI Agent Workspace",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [400, 900]
    },
    {
      "parameters": {
        "jsCode": "const agentOutput = $input.first().json.output || $input.first().json.text || $input.first().json.response || 'Hello! Welcome to Adron Homes. How can I assist you with land plots or payment plans?';\n\nreturn {\n  json: {\n    success: true,\n    sessionId: $('3. Webhook - AI Chatbot Query').item.json.body.sessionId,\n    output: agentOutput,\n    suggestedActions: [\n      'Tell me about 300sqm plot',\n      'Do you offer installments?',\n      'Book free site inspection'\n    ]\n  }\n};"
      },
      "id": "node_format_response",
      "name": "Format JSON Chat Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 900]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, sessionId: $('3. Webhook - AI Chatbot Query').item.json.body.sessionId, output: $json.output } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node_respond_to_webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [950, 900]
    }
  ],
