      "ai_tool": [
        [
          { "node": "Adron 5-Tool AI Agent Workspace", "type": "ai_tool", "index": 0 }
        ]
      ]
    },
    "Tool 3 — FAQ Knowledgebase API": {
      "ai_tool": [
        [
          { "node": "Adron 5-Tool AI Agent Workspace", "type": "ai_tool", "index": 0 }
        ]
      ]
    },
    "Tool 4 — Create Lead API": {
      "ai_tool": [
        [
          { "node": "Adron 5-Tool AI Agent Workspace", "type": "ai_tool", "index": 0 }
        ]
      ]
    },
    "Tool 5 — Schedule Inspection API": {
      "ai_tool": [
        [
          { "node": "Adron 5-Tool AI Agent Workspace", "type": "ai_tool", "index": 0 }
        ]
      ]
    },
    "Adron 5-Tool AI Agent Workspace": {
      "main": [
        [
          { "node": "Format JSON Chat Response", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
